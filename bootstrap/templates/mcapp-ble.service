[Unit]
Description=McApp BLE Service
After=bluetooth.target dbus.service
Wants=bluetooth.target

[Service]
Type=simple
User={{USER}}
WorkingDirectory={{HOME}}/mcapp-slots/current
Environment="PATH={{HOME}}/.local/bin:/usr/local/bin:/usr/bin:/bin"
Environment="BLE_SERVICE_API_KEY={{BLE_API_KEY}}"
Environment="PYTHONUNBUFFERED=1"
Environment="MALLOC_ARENA_MAX=2"
ExecStartPre=+/usr/sbin/rfkill unblock bluetooth
ExecStartPre=/bin/sleep 2
ExecStartPre=+/usr/bin/bluetoothctl power on
# uv run is not used at exec time: deploy.sh runs uv sync; the wrapper cost
# ~10 MB virtual per service and a resolver step per restart. WorkingDirectory
# above is what makes `ble_service.src.main:app` resolve -- uvicorn's CLI
# inserts cwd into sys.path via its --app-dir default of "" (uvicorn/main.py).
ExecStart={{HOME}}/mcapp-slots/current/.venv/bin/uvicorn ble_service.src.main:app --host 127.0.0.1 --port 8081
Restart=on-failure
RestartSec=5

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
ReadWritePaths={{HOME}}/mcapp-slots {{HOME}}/.cache/uv /var/lib/mcapp

[Install]
WantedBy=multi-user.target
